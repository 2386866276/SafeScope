import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.sp
import androidx.core.content.res.ResourcesCompat

private class GoogleSansFontFamily private constructor(
    private val typeface: android.graphics.Typeface
) : FontFamily() {
    override val typeFaces: Map<FontWeight, android.graphics.Typeface> = mapOf(
        FontWeight.Normal to typeface,
        FontWeight.Medium to typeface,
        FontWeight.Bold to typeface
    )
}

private fun googleSans(context: Context): FontFamily {
    val typeface = ResourcesCompat.getFont(context, com.safescope.scanner.R.font.googlesans)
        ?: android.graphics.Typeface.DEFAULT
    return GoogleSansFontFamily(typeface)
}

private lateinit var cachedFontFamily: FontFamily

fun setAppFontFamily(context: Context) {
    cachedFontFamily = googleSans(context)
}

