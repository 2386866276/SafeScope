@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ShAnalysisScreen(
    onBack: () -> Unit = {}
) {
    var analysis by remember { mutableStateOf<ShScriptAnalysis?>(null) }
    var isLoading by remember { mutableStateOf(true) }

    LaunchedEffect(Unit) {
        isLoading = true
        withContext(Dispatchers.IO) {
            try {
                val context = androidx.compose.ui.platform.LocalContext.current
                val assetManager = context.assets
                val inputStream = assetManager.open("sample_malicious.sh")
                analysis = ShScriptAnalyzer.analyze(inputStream, "sample_malicious.sh")
            } catch (e: Exception) {
                analysis = null
            } finally {
                isLoading = false
            }
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Shell 脚本深度分析") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "返回")
                    }
                }
            )
        }
    ) { innerPadding ->
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .padding(horizontal = 16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp),
            contentPadding = PaddingValues(vertical = 16.dp)
        ) {
            if (isLoading) {
                item {
                    Box(
                        modifier = Modifier.fillMaxSize(),
                        contentAlignment = Alignment.Center
                    ) {
                        Text("正在分析脚本...")
                    }
                }
            } else if (analysis != null) {
                val result = analysis!!

                item {
                    Row(
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        Icon(
                            imageVector = Icons.Default.Code,
                            contentDescription = null,
                            modifier = Modifier.padding(end = 8.dp),
                            tint = MaterialTheme.colorScheme.primary
                        )
                        Column(modifier = Modifier.weight(1f)) {
                            Text(
                                text = result.fileName,
                                style = MaterialTheme.typography.titleLarge,
                                fontWeight = FontWeight.Bold
                            )
                            Text(
                                text = "${result.lineCount} 行 · ${result.fileSize} 字节",
                                style = MaterialTheme.typography.bodyMedium,
                                color = MaterialTheme.colorScheme.onSurfaceVariant
                            )
                        }
                        androidx.compose.material3.AssistChip(
                            onClick = {},
                            enabled = false,
                            colors = androidx.compose.material3.AssistChipDefaults.assistChipColors(
                                containerColor = result.overallRisk.color
                            ),
                            label = {
                                Text(
                                    text = result.overallRisk.label,
                                    color = androidx.compose.ui.graphics.Color.White
                                )
                            }
                        )
                    }
                }

                item {
                    ActionCard(
                        title = "建议处理动作",
                        action = result.suggestedAction,
                        summary = result.summary
                    )
                }

                if (result.suspiciousPatterns.isNotEmpty()) {
                    item {
                        Text(
                            text = "风险命中 (${result.suspiciousPatterns.size})",
                            style = MaterialTheme.typography.titleMedium,
                            fontWeight = FontWeight.Bold,
                            color = MaterialTheme.colorScheme.error
                        )
                    }
                    items(result.suspiciousPatterns) { pattern ->
                        Card(
                            modifier = Modifier.fillMaxWidth(),
                            colors = CardDefaults.cardColors(
                                containerColor = MaterialTheme.colorScheme.errorContainer
                            )
                        ) {
                            Row(
                                modifier = Modifier.padding(12.dp),
                                verticalAlignment = Alignment.CenterVertically,
                                horizontalArrangement = Arrangement.spacedBy(8.dp)
                            ) {
                                Icon(
                                    imageVector = Icons.Default.Warning,
                                    contentDescription = null,
                                    modifier = Modifier.size(18.dp),
                                    tint = MaterialTheme.colorScheme.error
                                )
                                Text(
                                    text = pattern,
                                    style = MaterialTheme.typography.bodyMedium,
                                    color = MaterialTheme.colorScheme.onErrorContainer
                                )
                            }
                        }
                    }
                }

                if (result.decodedSnippets.isNotEmpty()) {
                    item {
                        Spacer(modifier = Modifier.height(8.dp))
                        Text(
                            text = "解码内容 (${result.decodedSnippets.size})",
                            style = MaterialTheme.typography.titleMedium,
                            fontWeight = FontWeight.Bold
                        )
                    }
                    items(result.decodedSnippets) { snippet ->
                        DecodedCard(snippet = snippet)
                    }
                }
            }
        }
    }
}

@Composable
private fun ActionCard(
    title: String,
    action: ScriptAnalysisAction,
    summary: String
) {
    val containerColor = when (action) {
        ScriptAnalysisAction.BLOCK -> MaterialTheme.colorScheme.errorContainer
        ScriptAnalysisAction.WARN -> MaterialTheme.colorScheme.tertiaryContainer
        ScriptAnalysisAction.MONITOR -> MaterialTheme.colorScheme.primaryContainer
        ScriptAnalysisAction.NONE -> MaterialTheme.colorScheme.surfaceVariant
    }

    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(containerColor = containerColor)
    ) {
        Column(
            modifier = Modifier.padding(20.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = title,
                    style = MaterialTheme.typography.titleMedium,
                    fontWeight = FontWeight.Bold
                )
                androidx.compose.material3.AssistChip(
                    onClick = {},
                    enabled = false,
                    label = { Text(text = action.label) }
                )
            }
            Text(
                text = summary,
                style = MaterialTheme.typography.bodyMedium
            )
        }
    }
}

@Composable
private fun DecodedCard(snippet: DecodedSnippet) {
    val riskColor = when (snippet.riskHint) {
        "high" -> RiskLevel.DANGEROUS.color
        "medium" -> RiskLevel.WARNING.color
        else -> RiskLevel.SAFE.color
    }

    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(
            containerColor = MaterialTheme.colorScheme.surfaceVariant
        )
    ) {
        Column(
            modifier = Modifier.padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(6.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = snippet.encodingType,
                    style = MaterialTheme.typography.labelMedium,
                    fontWeight = FontWeight.Bold
                )
                androidx.compose.material3.AssistChip(
                    onClick = {},
                    enabled = false,
                    colors = androidx.compose.material3.AssistChipDefaults.assistChipColors(
                        containerColor = riskColor
                    ),
                    label = {
                        Text(
                            text = snippet.riskHint,
                            color = androidx.compose.ui.graphics.Color.White
                        )
                    }
                )
            }
            Text(
                text = "原文：${snippet.original}",
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
            Text(
                text = "解码：${snippet.decoded}",
                style = MaterialTheme.typography.bodyMedium,
                fontFamily = FontFamily.Monospace
            )
        }
    }
}