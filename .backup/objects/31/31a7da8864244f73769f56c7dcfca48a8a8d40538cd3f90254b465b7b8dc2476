@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun FileScanScreen(onBack: () -> Unit = {}) {
    var files by remember { mutableStateOf<List<SuspiciousFile>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }
    val context = LocalContext.current

    LaunchedEffect(Unit) {
        withContext(Dispatchers.IO) {
            try { files = SuspiciousFileScanner.scanSuspiciousFiles() }
            catch (_: Exception) { files = emptyList() }
            finally { isLoading = false }
        }
    }

    val highRisk = files.filter { it.riskLevel == RiskLevel.HIGH || it.riskLevel == RiskLevel.CRITICAL }
    val mt2Files = files.filter { it.isMT2Related }
    val otherFiles = files.filter { it !in highRisk && it !in mt2Files }

    Scaffold(
        topBar = { TopAppBar(title = { Text("MT2/异常文件扫描") }, navigationIcon = { IconButton(onClick = onBack) { Icon(Icons.Default.ArrowBack, "返回") } }) }
    ) { innerPadding ->
        if (isLoading) {
            Box(Modifier.fillMaxSize().padding(innerPadding), contentAlignment = Alignment.Center) {
                Column(horizontalAlignment = Alignment.CenterHorizontally) { CircularProgressIndicator(); Spacer(Modifier.height(16.dp)); Text("正在扫描文件...") }
            }
        } else {
            LazyColumn(
                Modifier.fillMaxSize().padding(innerPadding).padding(horizontal = 16.dp),
                Arrangement.spacedBy(10.dp), PaddingValues(vertical = 16.dp)
            ) {
                item {
                    Card(Modifier.fillMaxWidth(), RoundedCornerShape(16.dp), colors = CardDefaults.cardColors(
                        containerColor = if (files.isEmpty()) MaterialTheme.colorScheme.primaryContainer else MaterialTheme.colorScheme.errorContainer
                    )) {
                        Row(Modifier.padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
                            Icon(Icons.Default.Folder, null, Modifier.size(32.dp), tint = if (files.isEmpty()) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error)
                            Spacer(Modifier.width(12.dp))
                            Column(Modifier.weight(1f)) {
                                Text(if (files.isEmpty()) "未发现异常" else "发现 ${files.size} 个可疑项", style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold)
                                Text(if (files.isEmpty()) "设备看起来正常" else "请仔细检查以下内容", style = MaterialTheme.typography.bodySmall)
                            }
                            Button(onClick = { files = emptyList(); isLoading = true }) { Text("重新扫描") }
                        }
                    }
                }
                if (files.isEmpty()) return@LazyColumn
                if (highRisk.isNotEmpty()) {
                    item { Text("高风险 (${highRisk.size})", style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold, color = MaterialTheme.colorScheme.error) }
                    items(highRisk) { SuspiciousFileCard(it) }
                }
                if (mt2Files.isNotEmpty()) {
                    item { Spacer(Modifier.height(4.dp)); Text("MT2/管理器相关 (${mt2Files.size})", style = MaterialTheme.typography.titleSmall, color = MaterialTheme.colorScheme.onSurfaceVariant) }
                    items(mt2Files) { SuspiciousFileCard(it) }
                }
                if (otherFiles.isNotEmpty()) {
                    item { Spacer(Modifier.height(4.dp)); Text("其他可疑文件 (${otherFiles.size})", style = MaterialTheme.typography.titleSmall, color = MaterialTheme.colorScheme.onSurfaceVariant) }
                    items(otherFiles) { SuspiciousFileCard(it) }
                }
            }
        }
    }
}

@Composable
private fun SuspiciousFileCard(file: SuspiciousFile) {
    Card(Modifier.fillMaxWidth(), RoundedCornerShape(12.dp), colors = CardDefaults.cardColors(containerColor = file.riskLevel.bgColor.copy(alpha = 0.35f))) {
        Column(Modifier.padding(14.dp), Arrangement.spacedBy(4.dp)) {
            Row(Modifier.fillMaxWidth(), Arrangement.SpaceBetween, Alignment.CenterVertically) {
                Row(verticalAlignment = Alignment.CenterVertically, modifier = Modifier.weight(1f)) {
                    Icon(Icons.Default.Folder, null, Modifier.size(16.dp), tint = MaterialTheme.colorScheme.primary)
                    Spacer(Modifier.width(6.dp))
                    Text(file.fileName, style = MaterialTheme.typography.titleSmall, fontWeight = FontWeight.Bold)
                }
                androidx.compose.material3.AssistChip(onClick = {}, enabled = false, colors = androidx.compose.material3.AssistChipDefaults.assistChipColors(containerColor = file.riskLevel.color), label = { Text(file.riskLevel.label, color = androidx.compose.ui.graphics.Color.White) })
            }
            Text(file.reason, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.error)
            Text(file.path, style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
        }
    }
}