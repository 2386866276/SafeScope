    fun scanInstalledApps(context: Context): List<AppThreatInfo> {
        val results = mutableListOf<AppThreatInfo>()
        val pm = context.packageManager

        val packages = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            pm.getInstalledPackages(PackageManager.ApplicationInfoFlags.of(0))
        } else {
            @Suppress("DEPRECATION")
            pm.getInstalledPackages(0)
        }

        for (pkgInfo in packages) {
            val appInfo = pkgInfo.applicationInfo ?: continue
            val appName = appInfo.loadLabel(pm).toString()
            val packageName = pkgInfo.packageName
            val versionName = pkgInfo.versionName
            val installer = try {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                    pm.getInstallSourceInfo(packageName).installingPackageName
                } else {
                    @Suppress("DEPRECATION")
                    pm.getInstallerPackageName(packageName)
                }
            } catch (e: Exception) {
                "unknown"
            }

            val riskLevel = calculateRiskLevel(pkgInfo, installer)
            val riskReason = buildRiskReason(pkgInfo, installer, riskLevel)
            val permissions = getDangerousPermissions(pkgInfo)

            results.add(
                AppThreatInfo(
                    packageName = packageName,
                    appName = appName,
                    versionName = versionName,
                    riskLevel = riskLevel,
                    riskReason = riskReason,
                    installer = installer,
                    isSystemApp = (appInfo.flags and ApplicationInfo.FLAG_SYSTEM) != 0,
                    permissions = permissions
                )
            )
        }

        return results.sortedByDescending { it.riskLevel.ordinal }
    }

    private fun calculateRiskLevel(pkgInfo: PackageInfo, installer: String?): RiskLevel {
        val packageName = pkgInfo.packageName
        val appInfo = pkgInfo.applicationInfo ?: return RiskLevel.NONE
        val flags = appInfo.flags

        val isSystemApp = (flags and ApplicationInfo.FLAG_SYSTEM) != 0
        val isUpdatedSystemApp = (flags and ApplicationInfo.FLAG_UPDATED_SYSTEM_APP) != 0
        val isFromUnknownSource = installer == null || installer.equals("unknown", true)

        val dangerousPerms = getDangerousPermissions(pkgInfo).size

        return when {
            KNOWN_RISK_APPS.containsKey(packageName) -> RiskLevel.HIGH
            isFromUnknownSource && dangerousPerms >= 3 -> RiskLevel.CRITICAL
            isFromUnknownSource && dangerousPerms >= 1 -> RiskLevel.HIGH
            isFromUnknownSource -> RiskLevel.MEDIUM
            !isSystemApp && !isUpdatedSystemApp && dangerousPerms >= 5 -> RiskLevel.HIGH
            !isSystemApp && !isUpdatedSystemApp && dangerousPerms >= 2 -> RiskLevel.MEDIUM
            isUpdatedSystemApp && dangerousPerms >= 4 -> RiskLevel.MEDIUM
            else -> RiskLevel.NONE
        }
    }

    private fun buildRiskReason(pkgInfo: PackageInfo, installer: String?, riskLevel: RiskLevel): String {
        val reasons = mutableListOf<String>()
        val packageName = pkgInfo.packageName

        if (KNOWN_RISK_APPS.containsKey(packageName)) {
            reasons.add("已知工具/风险应用")
        }

        if (installer == null || installer.equals("unknown", true)) {
            reasons.add("未知来源安装")
        }

        val dangerousPerms = getDangerousPermissions(pkgInfo)
        if (dangerousPerms.size >= 3) {
            reasons.add("过多敏感权限(${dangerousPerms.size})")
        }

        if (riskLevel == RiskLevel.CRITICAL) {
            reasons.add("建议立即卸载")
        } else if (riskLevel == RiskLevel.HIGH) {
            reasons.add("建议卸载或谨慎使用")
        }

        return reasons.joinToString("; ").ifEmpty { "无明显风险" }
    }

    private fun getDangerousPermissions(pkgInfo: PackageInfo): List<String> {
        val requested = pkgInfo.requestedPermissions ?: return emptyList()
        return requested.filter { perm ->
            DANGEROUS_PERMISSIONS.any { it.equals(perm, true) }
        }
    }

    fun isUsageStatsPermissionGranted(context: Context): Boolean {
        val appOps = context.getSystemService(Context.APP_OPS_SERVICE) as AppOpsManager
        val mode = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
            appOps.unsafeCheckOpNoThrow(
                AppOpsManager.OPSTR_GET_USAGE_STATS,
                android.os.Process.myUid(),
                context.packageName
            )
        } else {
            @Suppress("DEPRECATION")
            appOps.checkOpNoThrow(
                AppOpsManager.OPSTR_GET_USAGE_STATS,
                android.os.Process.myUid(),
                context.packageName
            )
        }
        return mode == AppOpsManager.MODE_ALLOWED
    }

    fun getRecentApps(context: Context): List<String> {
        if (!isUsageStatsPermissionGranted(context)) {
            return emptyList()
        }

        val usageStatsManager = context.getSystemService(Context.USAGE_STATS_SERVICE) as UsageStatsManager
        val endTime = System.currentTimeMillis()
        val beginTime = endTime - 60 * 60 * 1000 // 最近1小时
        val stats = usageStatsManager.queryUsageStats(
            UsageStatsManager.INTERVAL_BEST,
            beginTime,
            endTime
        )
        return stats.sortedByDescending { it.lastTimeUsed }
            .take(20)
            .map { it.packageName }
    }
}