        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_SUPERUSER",
        "android.permission.BIND_DEVICE_ADMIN",
        "android.permission.INTERNET"
    )

    private val KNOWN_RISK_APPS = mapOf(
        "com.topjohnwu.magisk" to "Magisk Root 工具",
        "eu.chainfire.supersu" to "SuperSU Root 管理",
        "com.noshufou.android.su" to "Superuser Root 管理",
        "com.koushikdutta.superuser" to "Superuser Root 管理",
        "com.devadvance.rootcloak" to "RootCloak Root 隐藏",
        "de.robv.android.xposed" to "Xposed 框架",
        "me.weishu.exp" to "Exposed 框架",
        "com.kingroot.kinguser" to "KingRoot Root 工具",
        "com.rooting.kingoroot" to "KingoRoot Root 工具",
        "com.onekeyguard.root" to "OneKeyGuard Root 检测",
        "com.rechild.advancedtaskkiller" to "高级任务管理器",
