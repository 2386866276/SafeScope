@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun FileScanScreen(
    onBack: () -> Unit = {}
) {
    var files by remember { mutableStateOf<List<SuspiciousFile>>(emptyList()) }
    var isLoading by remember { mutableStateOf(true) }

    LaunchedEffect(Unit) {
        isLoading = true
        val context = LocalContext.current
        withContext(Dispatchers.IO) {
            try {
                files = SuspiciousFileScanner.scanSuspiciousFiles()
            } catch (e: Exception) {
                files = emptyList()
            } finally {
                isLoading = false
            }
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("MT2/异常文件扫描") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "返回")
                    }
                }
            )
        }
    ) { innerPadding ->
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .padding(horizontal = 16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp),
            contentPadding = PaddingValues(vertical = 16.dp)
        ) {
            item {
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Column(modifier = Modifier.weight(1f)) {
                        Text(
                            text = "扫描结果",
                            style = MaterialTheme.typography.titleLarge,
                            fontWeight = FontWeight.Bold
                        )
                        Text(
                            text = "发现 ${files.size} 个可疑文件/目录",
                            style = MaterialTheme.typography.bodyMedium,
                            color = if (files.isNotEmpty())
                                MaterialTheme.colorScheme.error
                            else
                                MaterialTheme.colorScheme.primary
                        )
                    }
                    Button(onClick = {
                        files = emptyList()
                        isLoading = true
                    }) {
                        Text("重新扫描")
                    }
                }
            }

            if (isLoading) {
                item {
                    Box(
                        modifier = Modifier.fillMaxSize(),
                        contentAlignment = Alignment.Center
                    ) {
                        Text("正在扫描文件...")
                    }
                }
            } else if (files.isEmpty()) {
                item {
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(
                            containerColor = MaterialTheme.colorScheme.primaryContainer
                        )
                    ) {
                        Column(
                            modifier = Modifier.padding(20.dp),
                            verticalArrangement = Arrangement.spacedBy(8.dp)
                        ) {
                            Text(
                                text = "未发现异常",
                                style = MaterialTheme.typography.titleMedium,
                                fontWeight = FontWeight.Bold,
                                color = MaterialTheme.colorScheme.primary
                            )
                            Text(
                                text = "未发现 MT2 目录或可疑文件，设备看起来正常。",
                                style = MaterialTheme.typography.bodyMedium
                            )
                        }
                    }
                }
            } else {
                val mt2Files = files.filter { it.isMT2Related }
                val highRisk = files.filter { it.riskLevel == RiskLevel.HIGH || it.riskLevel == RiskLevel.CRITICAL }

                if (highRisk.isNotEmpty()) {
                    item {
                        Text(
                            text = "高风险 (${highRisk.size})",
                            style = MaterialTheme.typography.titleMedium,
                            color = MaterialTheme.colorScheme.error,
                            fontWeight = FontWeight.Bold
                        )
                    }
                }

                items(highRisk) { file ->
                    SuspiciousFileCard(file = file)
                }

                if (mt2Files.isNotEmpty()) {
                    item {
                        Spacer(modifier = Modifier.height(8.dp))
                        Text(
                            text = "MT2/管理器相关 (${mt2Files.size})",
                            style = MaterialTheme.typography.titleMedium,
                            color = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                }

                items(mt2Files) { file ->
                    SuspiciousFileCard(file = file)
                }

                item {
                    Spacer(modifier = Modifier.height(8.dp))
                    Text(
                        text = "其他可疑文件 (${files.size - highRisk.size - mt2Files.size})",
                        style = MaterialTheme.typography.titleSmall,
                        color = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                }

                val otherFiles = files.filter {
                    it !in highRisk && it !in mt2Files
                }
                items(otherFiles) { file ->
                    SuspiciousFileCard(file = file)
                }
            }
        }
    }
}

@Composable
private fun SuspiciousFileCard(file: SuspiciousFile) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(
            containerColor = file.riskLevel.bgColor.copy(alpha = 0.3f)
        )
    ) {
        Column(
            modifier = Modifier.padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(4.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(8.dp),
                    modifier = Modifier.weight(1f)
                ) {
                    Icon(
                        imageVector = Icons.Default.Folder,
                        contentDescription = null,
                        modifier = Modifier.size(20.dp),
                        tint = MaterialTheme.colorScheme.primary
                    )
                    Text(
                        text = file.fileName,
                        style = MaterialTheme.typography.titleMedium,
                        fontWeight = FontWeight.Bold
                    )
                }
                androidx.compose.material3.AssistChip(
                    onClick = {},
                    enabled = false,
                    colors = androidx.compose.material3.AssistChipDefaults.assistChipColors(
                        containerColor = file.riskLevel.color
                    ),
                    label = {
                        Text(
                            text = file.riskLevel.label,
                            color = androidx.compose.ui.graphics.Color.White
                        )
                    }
                )
            }
            Text(
                text = file.reason,
                style = MaterialTheme.typography.bodyMedium,
                color = MaterialTheme.colorScheme.error
            )
            Text(
                text = "路径: ${file.path}",
                style = MaterialTheme.typography.bodySmall,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
        }
    }
}