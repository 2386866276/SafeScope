package com.safescope.scanner.scanner

import android.Manifest
import android.app.ActivityManager
import android.content.Context
import android.content.pm.PackageManager
import android.os.Build
import android.os.Environment
import android.os.StatFs
import android.telephony.TelephonyManager
import android.util.DisplayMetrics
import android.view.WindowManager
import com.safescope.scanner.model.DeviceInfo
import java.io.File

object DeviceInfoScanner {

    fun getDeviceInfo(context: Context): DeviceInfo {
        val pm = context.packageManager
        val tm = context.getSystemService(Context.TELEPHONY_SERVICE) as? TelephonyManager

        val brand = Build.BRAND
        val model = Build.MODEL
        val androidVersion = Build.VERSION.RELEASE
        val apiLevel = Build.VERSION.SDK_INT
        val fingerprint = Build.FINGERPRINT
        val serial = getSerial()
        val imei = getIMEI(tm, context)
        val phoneNumber = getPhoneNumber(tm, context)
        val cpuAbi = getCPUAbis()
        val memInfo = getMemoryInfo(context)
        val isRooted = checkRoot()
        val isUSBConnected = USBDebugDetector.isUSBConnected(context)
        val isUSBDebugEnabled = USBDebugDetector.detectUSBDebugStatus(context).isEnabled
        val batteryLevel = getBatteryLevel(context)
        val securityPatch = Build.VERSION.SECURITY_PATCH
        val baseband = Build.getRadioVersion()
        val buildTime = getBuildTime()

        return DeviceInfo(
            brand = brand,
            model = model,
            androidVersion = androidVersion,
            apiLevel = apiLevel,
            sdkInt = apiLevel,
            fingerprint = fingerprint,
            serial = serial,
            imei = imei,
            phoneNumber = phoneNumber,
            cpuAbi = cpuAbi,
            totalMemory = memInfo.first,
            availableMemory = memInfo.second,
            isRooted = isRooted,
            isUSBConnected = isUSBConnected,
            isUSBDebugEnabled = isUSBDebugEnabled,
            batteryLevel = batteryLevel,
            securityPatch = securityPatch,
            baseband = baseband,
            buildTime = buildTime
        )
    }

    private fun getSerial(): String? {
        return try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                Build.getSerial()
            } else {
                @Suppress("DEPRECATION")
                Build.SERIAL
            }
        } catch (e: SecurityException) {
            "未授权"
        } catch (e: Exception) {
            "未知"
        }
    }

    private fun getIMEI(tm: TelephonyManager?, context: Context): String? {
        if (tm == null) return null
        return try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                if (context.checkSelfPermission(Manifest.permission.READ_PHONE_STATE) == PackageManager.PERMISSION_GRANTED) {
                    tm.imei
                } else {
                    "未授权"
                }
            } else {
                @Suppress("DEPRECATION")
                tm.deviceId
            }
        } catch (e: SecurityException) {
            "未授权"
        } catch (e: Exception) {
            "未知"
        }
    }

    private fun getPhoneNumber(tm: TelephonyManager?, context: Context): String? {
        if (tm == null) return null
        return try {
            if (context.checkSelfPermission(Manifest.permission.READ_PHONE_STATE) == PackageManager.PERMISSION_GRANTED) {
                @Suppress("DEPRECATION")
                tm.line1Number ?: "未知"
            } else {
                "未授权"
            }
        } catch (e: SecurityException) {
            "未授权"
        } catch (e: Exception) {
            "未知"
        }
    }

    private fun getCPUAbis(): List<String> {
        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
            Build.SUPPORTED_ABIS.toList()
        } else {
            @Suppress("DEPRECATION")
            listOf(Build.CPU_ABI, Build.CPU_ABI2)
        }
    }

    private fun getMemoryInfo(context: Context): Pair<Long, Long> {
        val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
        val memInfo = ActivityManager.MemoryInfo()
        activityManager.getMemoryInfo(memInfo)
        return Pair(memInfo.totalMem, memInfo.availMem)
    }

    private fun checkRoot(): Boolean {
        val paths = arrayOf(
            "/system/bin/su",
            "/system/xbin/su",
            "/system/app/Superuser.apk",
            "/system/app/SuperSU.apk",
            "/system/etc/init.d/",
            "/system/xbin/daemonsu",
            "/system/bin/daemonsu",
            "/su/bin/su",
            "/magisk/.core/bin/su"
        )

        return paths.any { path ->
            try {
                File(path).exists()
            } catch (e: Exception) {
                false
            }
        }
    }

    private fun getBatteryLevel(context: Context): Int {
        return try {
            val batteryIntent = context.registerReceiver(
                null,
                android.content.IntentFilter(android.content.Intent.ACTION_BATTERY_CHANGED)
            ) ?: return -1
            val level = batteryIntent.getIntExtra(android.os.BatteryManager.EXTRA_LEVEL, -1)
            val scale = batteryIntent.getIntExtra(android.os.BatteryManager.EXTRA_SCALE, -1)
            if (level >= 0 && scale > 0) (level * 100) / scale else -1
        } catch (e: Exception) {
            -1
        }
    }

    private fun getBuildTime(): String {
        val buildTime = Build.TIME
        val sdf = java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss", java.util.Locale.getDefault())
        return sdf.format(java.util.Date(buildTime))
    }

    fun getStorageInfo(): Pair<Long, Long> {
        return try {
            val externalStorage = Environment.getExternalStorageDirectory()
            val stat = StatFs(externalStorage.path)
            val blockSize = stat.blockSizeLong
            val totalBlocks = stat.blockCountLong
            val availableBlocks = stat.availableBlocksLong
            Pair(totalBlocks * blockSize, availableBlocks * blockSize)
        } catch (e: Exception) {
            Pair(0L, 0L)
        }
    }
}