import kotlinx.coroutines.withContext

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun USBDebugScreen(
    onBack: () -> Unit = {}
) {
    var status by remember { mutableStateOf<USBDebugStatus?>(null) }
    var isLoading by remember { mutableStateOf(true) }

    LaunchedEffect(Unit) {
        isLoading = true
        val context = LocalContext.current
        withContext(Dispatchers.IO) {
            try {
                status = USBDebugDetector.detectUSBDebugStatus(context)
            } catch (e: Exception) {
                status = null
            } finally {
                isLoading = false
            }
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("USB 调试检测") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.Default.ArrowBack, contentDescription = "返回")
                    }
                }
            )
        }
    ) { innerPadding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            if (isLoading) {
                Box(
                    modifier = Modifier.fillMaxSize(),
                    contentAlignment = Alignment.Center
                ) {
                    Text("正在检测...")
                }
            } else if (status != null) {
                StatusCard(
                    title = "USB 调试状态",
                    value = if (status!!.isEnabled) "已开启" else "已关闭",
                    riskLevel = status!!.riskLevel,
                    detail = status!!.detail
                )

                StatusCard(
                    title = "检测时间",
                    value = status!!.detectionTime,
                    riskLevel = RiskLevel.INFO,
                    detail = "请定期检查此状态"
                )

                Card(
                    modifier = Modifier.fillMaxWidth(),
                    colors = CardDefaults.cardColors(
                        containerColor = MaterialTheme.colorScheme.surfaceVariant
                    )
                ) {
                    Column(
                        modifier = Modifier.padding(20.dp),
                        verticalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Text(
                            text = "安全建议",
                            style = MaterialTheme.typography.titleMedium,
                            fontWeight = FontWeight.Bold
                        )
                        Text(
                            text = if (status!!.isEnabled) {
                                "建议关闭 USB 调试功能，防止攻击者通过 USB 连接获取设备控制权。如需使用，请确保仅连接可信电脑。"
                            } else {
                                "USB 调试已关闭，设备相对安全。建议保持关闭状态。"
                            },
                            style = MaterialTheme.typography.bodyMedium,
                            color = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                    }
                }
            }
        }
    }
}

@Composable
private fun StatusCard(
    title: String,
    value: String,
    riskLevel: RiskLevel,
    detail: String
) {
    Card(
        modifier = Modifier.fillMaxWidth(),
        colors = CardDefaults.cardColors(
            containerColor = riskLevel.bgColor.copy(alpha = 0.3f)
        )
    ) {
        Column(
            modifier = Modifier.padding(20.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = title,
                    style = MaterialTheme.typography.titleMedium,
                    fontWeight = FontWeight.Bold
                )
                androidx.compose.material3.AssistChip(
                    onClick = {},
                    enabled = false,
                    colors = androidx.compose.material3.AssistChipDefaults.assistChipColors(
                        containerColor = riskLevel.color
                    ),
                    label = {
                        Text(
                            text = riskLevel.label,
                            color = androidx.compose.ui.graphics.Color.White
                        )
                    }
                )
            }
            Text(
                text = value,
                style = MaterialTheme.typography.headlineSmall,
                fontWeight = FontWeight.Bold,
                color = MaterialTheme.colorScheme.primary
            )
            Text(
                text = detail,
                style = MaterialTheme.typography.bodyMedium,
                color = MaterialTheme.colorScheme.onSurfaceVariant
            )
        }
    }
}